# Required - get one at https://z.ai (Login -> profile menu -> API Keys)
ZAI_API_KEY=your-key-here

# Optional - defaults to GLM-4.7-Flash, which is free (rate-limited, not a
# trial credit) and fits bulk screening well. Bump to glm-5.2 if you want
# sharper judgment on borderline cases - that one costs per-token.
ZAI_MODEL=glm-4.7-flash

# Optional - only needed for the Adzuna source (UK/AU/NZ/DE/NL job boards).
# Free signup at https://developer.adzuna.com
# Without these, Adzuna is silently skipped and you still get RemoteOK +
# Arbeitnow + Jobicy.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
