# ---- ZAI GLM (Zhipu) ----
# Get from https://open.bigmodel.cn/
ZAI_API_KEY=your_zai_api_key_here

# OpenAI-compatible base URL for ZAI/Zhipu GLM
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Model id. Set to your available GLM 5.x model id (e.g. glm-5.2 if provisioned).
ZAI_MODEL=glm-4.5

# ---- Firecrawl ----
# Get from https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1

# ---- Pipeline tuning ----
# Max result URLs to follow per search query
MAX_JOBS_PER_QUERY=5
# Overall cap on jobs that will be scored
MAX_JOBS_TO_SCORE=15
# Minimum score (0-100) for which we draft a cover letter
MIN_SCORE_TO_APPLY=70
# Max parallel HTTP calls to Firecrawl/ZAI during scoring
MAX_CONCURRENCY=4